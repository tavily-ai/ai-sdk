{
  "name": "@tavily/ai-sdk",
  "version": "0.6.0",
  "description": "Tavily AI SDK tools - Search, Extract, Crawl, Map, and Research",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm build",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:consumers": "tests/run-consumers.sh"
  },
  "keywords": [
    "ai",
    "ai-sdk",
    "tools",
    "tavily",
    "search",
    "web-search",
    "crawl",
    "extract"
  ],
  "author": "Tavily",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/tavily-ai/ai-sdk"
  },
  "homepage": "https://docs.tavily.com/documentation/integrations/vercel",
  "bugs": {
    "url": "https://github.com/tavily-ai/ai-sdk/issues"
  },
  "packageManager": "pnpm@10.8.0",
  "devDependencies": {
    "@ai-sdk/openai": "^4.0.118",
    "@types/node": "^26.6.6",
    "ai": "^7.0.173",
    "axios": "^1",
    "dotenv": "^18.0.10",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "zod": "^4.6.7"
  },
  "dependencies": {
    "@tavily/core": "^1.1.0"
  },
  "peerDependencies": {
    "ai": "^5.0.0 || ^6.0.0 || ^7.0.0",
    "zod": "^4.1.8"
  }
}
